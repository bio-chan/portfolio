{
   "action": {
      "default_icon": {
         "128": "128.png",
         "16": "icons/16.png",
         "32": "icons/32.png",
         "48": "icons/48.png"
      },
      "default_popup": "ui/popup.html"
   },
   "background": {
      "service_worker": "sw.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "engine/domains.js", "engine/bypass.js", "engine/cosmetics.js", "engine/flicker.js", "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "content-youtube.js" ],
      "matches": [ "*://*.youtube.com/*", "*://*.youtube-nocookie.com/*" ],
      "run_at": "document_start"
   } ],
   "declarative_net_request": {
      "rule_resources": [ {
         "enabled": true,
         "id": "default",
         "path": "rulesets/ruleset-default.json"
      }, {
         "enabled": true,
         "id": "badware",
         "path": "rulesets/ruleset-badware.json"
      }, {
         "enabled": true,
         "id": "privacy",
         "path": "rulesets/ruleset-privacy.json"
      }, {
         "enabled": false,
         "id": "youtube",
         "path": "rulesets/ruleset-youtube.json"
      } ]
   },
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "128.png",
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "options_ui": {
      "open_in_tab": true,
      "page": "ui/settings.html"
   },
   "permissions": [ "storage", "unlimitedStorage", "scripting", "declarativeNetRequest", "webNavigation", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2026.9.14.12",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "web_accessible_resources/*" ]
   }, {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "close.html", "128.png" ],
      "use_dynamic_url": true
   } ]
}
